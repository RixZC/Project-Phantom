<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Project_Phantom.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Project_Phantom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Project Phantom">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled"
        HorizontalScrollMode="Disabled"
        ZoomMode="Disabled">
        <Grid Padding="24">
            <Grid.Resources>
                <local:AccentColorBrushConverter x:Key="AccentColorBrushConverter" />
            </Grid.Resources>
            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="TitleText"
                    Text="Sound Mixer"
                    FontSize="28"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Manage your application volume groups"
                    Opacity="0.7" />

                <Button
                    Content="+ Add Group"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,8"
                    Click="AddGroupButton_Click" />

                <TextBlock
                    Text="Groups"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0" />

                <TextBlock
                    x:Name="EmptyGroupsTextBlock"
                    Text="No groups yet."
                    Opacity="0.7" />

                <TextBlock
                    x:Name="PersistenceStatusTextBlock"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="HotkeyStatusTextBlock"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <ItemsControl
                    x:Name="GroupsItemsControl"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander
                                Margin="0,0,0,8"
                                IsExpanded="False"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnSpacing="8" Padding="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding Name}"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Content="{Binding SelectionLabel}"
                                            MinWidth="68"
                                            Height="32"
                                            Padding="8,4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="SelectGroupButton_Click"
                                            ToolTipService.ToolTip="Choose which group the tray icon represents"
                                            AutomationProperties.Name="Select group for tray icon" />
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Spacing="8" Margin="16,0,16,16">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Minimum="0"
                                                Maximum="100"
                                                StepFrequency="1"
                                                Value="{Binding VolumePercent, Mode=TwoWay}"
                                                AutomationProperties.Name="Group volume" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding VolumeLabel}"
                                                   VerticalAlignment="Center"
                                                   HorizontalTextAlignment="Right" />
                                    </Grid>
                                    <Button HorizontalAlignment="Left"
                                            Padding="8,4"
                                            Click="ShortcutButton_Click"
                                            ToolTipService.ToolTip="Configure the global group-selection shortcut"
                                            AutomationProperties.Name="Group shortcut">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Shortcut" />
                                            <TextBlock Text="{Binding ShortcutLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Left"
                                            Padding="8,4"
                                            Click="AccentColorButton_Click"
                                            ToolTipService.ToolTip="Choose the tray accent color"
                                            AutomationProperties.Name="Tray accent color">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="16" Height="16" CornerRadius="4"
                                                    Background="{Binding AccentColor, Converter={StaticResource AccentColorBrushConverter}}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="Accent" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AccentColor}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        Text="Applications"
                                        FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding Applications}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              MaxHeight="180">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="0,3,20,3">
                                                    <Grid Padding="12,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{Binding DisplayName}"
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Text="{Binding Details}"
                                                                Opacity="0.7"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button
                                                            Grid.Column="1"
                                                            Content="×"
                                                            FontSize="18"
                                                            Width="32"
                                                            Height="32"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="0"
                                                            Click="RemoveApplicationButton_Click"
                                                            ToolTipService.ToolTip="Remove application from group"
                                                            AutomationProperties.Name="Remove application from group" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Content="Add Application"
                                            HorizontalAlignment="Left"
                                            Click="AddApplicationButton_Click" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Delete Group"
                                            HorizontalAlignment="Right"
                                            Click="DeleteGroupButton_Click"
                                            ToolTipService.ToolTip="Delete group"
                                            AutomationProperties.Name="Delete group" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
