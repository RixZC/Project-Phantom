<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Project_Phantom.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Project_Phantom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Project Phantom">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid Padding="24">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="TitleText"
                    Text="Sound Mixer"
                    FontSize="28"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Manage your application volume groups"
                    Opacity="0.7" />

                <Button
                    Content="+ Add Group"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,8"
                    Click="AddGroupButton_Click" />



                <TextBlock
                    Text="Groups"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0" />

                <TextBlock
                    x:Name="EmptyGroupsTextBlock"
                    Text="No groups yet."
                    Opacity="0.7" />

                <ItemsControl
                    x:Name="GroupsItemsControl"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander
                                Margin="0,0,0,8"
                                IsExpanded="False"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Margin="16"
                                        VerticalAlignment="Center" />
                                </Expander.Header>

                                <StackPanel Spacing="8" Margin="16,0,16,16">
                                    <TextBlock
                                        Text="Applications"
                                        FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Applications}" />
                                    <TextBlock
                                        Text="No applications assigned yet."
                                        Opacity="0.7" />
                                    <Button
                                        Content="Delete"
                                        HorizontalAlignment="Right"
                                        Click="DeleteGroupButton_Click"
                                        ToolTipService.ToolTip="Delete group"
                                        AutomationProperties.Name="Delete group" />
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
