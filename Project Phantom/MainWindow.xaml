<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Project_Phantom.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Project_Phantom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Project Phantom">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid Padding="24">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="TitleText"
                    Text="Sound Mixer"
                    FontSize="28"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Manage your application volume groups"
                    Opacity="0.7" />

                <Button
                    Content="+ Add Group"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,8"
                    Click="AddGroupButton_Click" />



                <TextBlock
                    Text="Groups"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0" />

                <TextBlock
                    x:Name="EmptyGroupsTextBlock"
                    Text="No groups yet."
                    Opacity="0.7" />

                <ItemsControl x:Name="GroupsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="16"
                                Margin="0,0,0,8"
                                CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="{Binding}"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />

                                    <Button
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        Click="DeleteGroupButton_Click"
                                        ToolTipService.ToolTip="Delete group"
                                        AutomationProperties.Name="Delete group">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
