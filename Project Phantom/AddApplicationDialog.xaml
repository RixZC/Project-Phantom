<ContentDialog
    x:Class="Project_Phantom.AddApplicationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Application"
    Width="600"
    Height="560"
    DefaultButton="Primary"
    PrimaryButtonText="Add"
    IsPrimaryButtonEnabled="False"
    CloseButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <Grid Width="496" Height="430">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
            x:Name="BrowseProcessesButton"
            Grid.Row="0"
            Grid.Column="1"
            Content="All Applications"
            Click="BrowseProcessesButton_Click"
            Margin="8,0,0,0" />

        <Button
            x:Name="BackToQuickAddButton"
            Grid.Row="0"
            Grid.Column="1"
            Content="Quick Add"
            Click="BackToQuickAddButton_Click"
            Margin="8,0,0,0"
            Visibility="Collapsed" />

        <Button
            x:Name="RefreshProcessesButton"
            Grid.Row="0"
            Grid.Column="2"
            Content="Refresh"
            Click="RefreshProcessesButton_Click"
            Margin="8,0,0,0"
            Visibility="Collapsed" />

        <TextBox
            x:Name="SearchTextBox"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            PlaceholderText="Search applications"
            TextChanged="SearchTextBox_TextChanged"
            Margin="0,12,0,8" />

        <TextBlock
            x:Name="ViewTitleTextBlock"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Text="Quick Add"
            FontSize="16"
            FontWeight="SemiBold"
            Margin="0,0,0,8" />

        <ListView
            x:Name="SessionsListView"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            SelectionMode="Single"
            HorizontalContentAlignment="Stretch"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Disabled"
            SelectionChanged="SessionsListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Text="{Binding DisplayName}"
                            FontWeight="SemiBold"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Text="{Binding Details}"
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Text="No active audio sessions found."
            Opacity="0.7"
            TextWrapping="NoWrap"
            TextTrimming="CharacterEllipsis"
            Margin="0,8,0,0"
            Visibility="Collapsed" />

    </Grid>
</ContentDialog>
