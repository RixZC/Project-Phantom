<ContentDialog
    x:Class="Project_Phantom.AddApplicationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Application"
    Width="600"
    Height="560"
    DefaultButton="Primary"
    PrimaryButtonText="Add"
    IsPrimaryButtonEnabled="False"
    CloseButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <DataTemplate x:Key="ApplicationEntryTemplate">
            <Grid Margin="0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Text="{Binding DisplayName}"
                    FontWeight="SemiBold"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Text="{Binding Details}"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid Width="496" Height="430">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="ViewTitleTextBlock"
            Grid.Row="0"
            Grid.Column="0"
            Text="All Applications"
            FontSize="16"
            FontWeight="SemiBold"
            VerticalAlignment="Center" />

        <Button
            x:Name="RefreshProcessesButton"
            Grid.Row="0"
            Grid.Column="1"
            Content="Refresh"
            Click="RefreshProcessesButton_Click"
            Margin="8,0,0,0"
            VerticalAlignment="Center" />

        <TextBox
            x:Name="SearchTextBox"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            PlaceholderText="Search applications"
            TextChanged="SearchTextBox_TextChanged"
            Margin="0,8,0,8" />

        <ListView
            x:Name="SessionsListView"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            SelectionMode="Single"
            HorizontalContentAlignment="Stretch"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ItemTemplate="{StaticResource ApplicationEntryTemplate}"
            SelectionChanged="SessionsListView_SelectionChanged" />

        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Text="Some applications may not expose a controllable audio session."
            Opacity="0.7"
            TextWrapping="Wrap"
            Margin="0,8,0,0"
            Visibility="Visible" />
    </Grid>
</ContentDialog>
