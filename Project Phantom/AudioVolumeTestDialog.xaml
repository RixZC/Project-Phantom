<ContentDialog
    x:Class="Project_Phantom.AudioVolumeTestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Temporary Audio Volume Test"
    Width="600"
    Height="400"
    CloseButtonText="Close">

    <StackPanel Width="520" Spacing="16">
        <TextBlock
            Text="Temporary Audio Volume Test"
            FontSize="18"
            FontWeight="SemiBold" />

        <TextBlock Text="Select an active audio session:" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="SessionsComboBox"
                Grid.Column="0"
                PlaceholderText="Choose an application"
                HorizontalAlignment="Stretch"
                SelectionChanged="SessionsComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="{Binding DisplayName}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{Binding Details}"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
                Grid.Column="1"
                Content="Refresh"
                Click="RefreshButton_Click" />
        </Grid>

        <TextBlock
            Text="Selected session volume"
            FontWeight="SemiBold" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider
                x:Name="VolumeSlider"
                Grid.Column="0"
                Minimum="0"
                Maximum="100"
                StepFrequency="1"
                IsEnabled="False"
                ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock
                x:Name="VolumePercentTextBlock"
                Grid.Column="1"
                Text="—%"
                MinWidth="48"
                VerticalAlignment="Center"
                TextAlignment="Right" />
        </Grid>

        <TextBlock
            x:Name="StatusTextBlock"
            Text="Select an active session to read its volume."
            Opacity="0.75"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
