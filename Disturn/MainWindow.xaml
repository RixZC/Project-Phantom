<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Disturn.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disturn"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Disturn">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="ChromeTitleBar" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInset" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="20" Height="20" Margin="24,0,8,0" VerticalAlignment="Center"
                       Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
                <TextBlock x:Name="ChromeTitleText" Grid.Column="1" Text="Disturn" Margin="0,0,12,0"
                           FontSize="14" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    <ScrollViewer x:Name="SoundMixerView" Grid.Row="1"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled"
        HorizontalScrollMode="Disabled"
        ZoomMode="Disabled">
        <Grid Padding="24">
            <Grid.Resources>
                <local:AccentColorBrushConverter x:Key="AccentColorBrushConverter" />
                <local:GroupExpansionToolTipConverter x:Key="GroupExpansionToolTipConverter" />
            </Grid.Resources>
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Text="Sound Mixer" FontSize="28" FontWeight="SemiBold" />
                    <Button x:Name="OpenSettingsButton" Grid.Column="1" Width="40" Height="40" Padding="0"
                            VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                            Click="OpenSettingsButton_Click" ToolTipService.ToolTip="Customize Disturn preferences"
                            AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="20" />
                    </Button>
                </Grid>

                <TextBlock
                    Text="Manage your application volume groups"
                    Opacity="0.7" />

                <Button
                    Content="+ Add Group"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,8"
                    Click="AddGroupButton_Click"
                    ToolTipService.ToolTip="Create a new audio group" />

                <TextBlock
                    Text="Groups"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0" />

                <TextBlock
                    x:Name="EmptyGroupsTextBlock"
                    Text="No groups yet."
                    Opacity="0.7" />

                <TextBlock
                    x:Name="PersistenceStatusTextBlock"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="HotkeyStatusTextBlock"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <ItemsControl
                    x:Name="GroupsItemsControl"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4" HorizontalAlignment="Stretch">
                            <Expander
                                x:Name="GroupCard"
                                MinHeight="72"
                                Padding="0"
                                CornerRadius="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                IsExpanded="False"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnSpacing="12" Padding="4,4,0,4" MinHeight="72"
                                          ToolTipService.ToolTip="{Binding IsExpanded, ElementName=GroupCard, Converter={StaticResource GroupExpansionToolTipConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding Name}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Content="{Binding SelectionLabel}"
                                            MinWidth="68" Height="32" Padding="8,4"
                                            Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Center"
                                            Click="SelectGroupButton_Click"
                                            ToolTipService.ToolTip="Select this group for volume commands"
                                            AutomationProperties.Name="Select group for volume commands" />
                                    </Grid>
                                </Expander.Header>

                                <Grid Margin="-1,0,-1,-1">
                                <StackPanel Spacing="8" Margin="33,16,33,33">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0"
                                                Minimum="0"
                                                Maximum="100"
                                                StepFrequency="1"
                                                Value="{Binding VolumePercent, Mode=TwoWay}"
                                                ToolTipService.ToolTip="Adjust the volume of all apps in this group"
                                                AutomationProperties.Name="Group volume" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding VolumeLabel}"
                                                   VerticalAlignment="Center"
                                                   HorizontalTextAlignment="Right" />
                                    </Grid>
                                    <Button HorizontalAlignment="Left"
                                            Padding="8,4"
                                            Click="ShortcutButton_Click"
                                            ToolTipService.ToolTip="Set a shortcut to select this group"
                                            AutomationProperties.Name="Group shortcut">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Shortcut" />
                                            <TextBlock Text="{Binding ShortcutLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Left"
                                            Padding="8,4"
                                            Click="AccentColorButton_Click"
                                            ToolTipService.ToolTip="Choose the tray accent color"
                                            AutomationProperties.Name="Tray accent color">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="16" Height="16" CornerRadius="4"
                                                    Background="{Binding AccentColor, Converter={StaticResource AccentColorBrushConverter}}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="Accent" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AccentColor}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        Text="Applications"
                                        FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding Applications}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              MaxHeight="180">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="0,3,20,3">
                                                    <Grid Padding="12,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{Binding DisplayName}"
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Text="{Binding Details}"
                                                                Opacity="0.7"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button
                                                            Grid.Column="1"
                                                            FontSize="18"
                                                            Width="32"
                                                            Height="32"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="0"
                                                            Click="RemoveApplicationButton_Click"
                                                            ToolTipService.ToolTip="Remove this app from the group"
                                                            AutomationProperties.Name="Remove application from group">
                                                            <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Content="Add Application"
                                            HorizontalAlignment="Left"
                                            Click="AddApplicationButton_Click"
                                            ToolTipService.ToolTip="Choose an app to add to this group" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Delete Group"
                                            HorizontalAlignment="Right"
                                            Click="DeleteGroupButton_Click"
                                            ToolTipService.ToolTip="Delete this group"
                                            AutomationProperties.Name="Delete group" />
                                    </Grid>
                                </StackPanel>
                                <Border Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        CornerRadius="0,0,0,2" IsHitTestVisible="False"
                                        Background="{Binding AccentColor, Converter={StaticResource AccentColorBrushConverter}}" />
                                </Grid>
                            </Expander>
                            <Border Width="3" Height="72" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    CornerRadius="2,0,0,0" IsHitTestVisible="False"
                                    Background="{Binding AccentColor, Converter={StaticResource AccentColorBrushConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed"
                  VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                  HorizontalScrollMode="Disabled" ZoomMode="Disabled">
        <StackPanel Padding="24" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SettingsBackButton" Width="40" Height="40" Padding="0"
                        Background="Transparent" BorderThickness="0" Click="SettingsBackButton_Click"
                        ToolTipService.ToolTip="Back to Sound Mixer" AutomationProperties.Name="Back to Sound Mixer">
                    <FontIcon Glyph="&#xE72B;" FontSize="20" />
                </Button>
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Text, ElementName=PersistenceStatusTextBlock}"
                       Visibility="{Binding Visibility, ElementName=PersistenceStatusTextBlock}"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Text, ElementName=HotkeyStatusTextBlock}"
                       Visibility="{Binding Visibility, ElementName=HotkeyStatusTextBlock}"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Volume Controls" FontSize="20" FontWeight="SemiBold" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Global shortcuts adjust the selected group. Without a selected group, they adjust Windows master volume."
                                   TextWrapping="Wrap" Opacity="0.7" />
                        <Button Tag="Up" Click="VolumeShortcutButton_Click" HorizontalAlignment="Left"
                                ToolTipService.ToolTip="Set a global shortcut for increasing volume">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Volume Up" />
                                <TextBlock x:Name="VolumeUpShortcutText" Text="Not assigned" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Down" Click="VolumeShortcutButton_Click" HorizontalAlignment="Left"
                                ToolTipService.ToolTip="Set a global shortcut for decreasing volume">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Volume Down" />
                                <TextBlock x:Name="VolumeDownShortcutText" Text="Not assigned" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Volume adjustment step" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="VolumeStepSlider" Minimum="1" Maximum="20"
                                    StepFrequency="1" Value="2"
                                    ToolTipService.ToolTip="Choose percentage points per volume shortcut press"
                                    AutomationProperties.Name="Volume adjustment step in percentage points" />
                            <TextBlock x:Name="VolumeStepText" Grid.Column="1" Text="2%"
                                       VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Default Group" FontSize="20" FontWeight="SemiBold" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="12">
                        <ComboBox x:Name="DefaultTargetComboBox" Header="Default volume target"
                                  ToolTipService.ToolTip="Choose the startup and automatic return volume target"
                                  HorizontalAlignment="Stretch" />
                        <ToggleSwitch x:Name="AutomaticReturnToggle" Header="Automatically return to default"
                                      ToolTipService.ToolTip="Return to the default target after volume inactivity"
                                      OnContent="Enabled" OffContent="Disabled" />
                        <ComboBox x:Name="ReturnDelayComboBox" Header="Return after"
                                  ToolTipService.ToolTip="Set when to return to the default target"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="10 seconds" Tag="10" />
                            <ComboBoxItem Content="30 seconds" Tag="30" />
                            <ComboBoxItem Content="60 seconds" Tag="60" />
                            <ComboBoxItem Content="2 minutes" Tag="120" />
                            <ComboBoxItem Content="5 minutes" Tag="300" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Startup" FontSize="20" FontWeight="SemiBold" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="12">
                        <ToggleSwitch x:Name="LaunchWithWindowsToggle"
                                      Header="Launch Disturn when Windows starts"
                                      ToolTipService.ToolTip="Start Disturn when you sign in to Windows"
                                      OnContent="Enabled" OffContent="Disabled" IsEnabled="False" />
                        <ToggleSwitch x:Name="StartMinimizedToggle"
                                      Header="Start minimized to system tray"
                                      ToolTipService.ToolTip="Hide the window only when Windows starts Disturn"
                                      OnContent="Enabled" OffContent="Disabled" IsEnabled="False" />
                        <TextBlock x:Name="StartupStatusText" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Tray icon appearance" FontSize="20" FontWeight="SemiBold" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Choose the volume indicator's text color for your taskbar."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="TrayAppearanceComboBox" MinWidth="220"
                                  ToolTipService.ToolTip="Change tray text without changing the app theme"
                                  AutomationProperties.Name="Tray icon appearance">
                            <ComboBoxItem Content="Automatic (follow Windows)" Tag="Automatic" />
                            <ComboBoxItem Content="Light mode" Tag="Light" />
                            <ComboBoxItem Content="Dark mode" Tag="Dark" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Show Disturn on taskbar" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Keep the volume indicator visible outside the hidden-icons menu."
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Open Settings" VerticalAlignment="Center"
                                    Click="OpenTaskbarSettingsButton_Click"
                                    ToolTipService.ToolTip="Open Windows taskbar personalization"
                                    AutomationProperties.Name="Open Windows taskbar settings" />
                        </Grid>
                        <TextBlock Text="In Windows Settings, expand &quot;Other system tray icons&quot; and enable Disturn."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TaskbarSettingsStatusText" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="4" Margin="0,24,0,8">
                <TextBlock Text="Disturn - Project Phantom" FontSize="14" FontWeight="SemiBold"
                           TextAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Made with &#x2764;&#xFE0F; by RixZC" FontSize="12"
                           TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="V1.0.0" FontSize="11"
                           TextAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Window>

