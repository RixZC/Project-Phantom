<Window
    x:Class="Disturn.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Disturn tray menu">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Border x:Name="MenuRoot" Background="Transparent" CornerRadius="8"
            BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" Padding="4">
        <Border.Resources>
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <Style x:Key="TrayMenuItemStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </Border.Resources>
        <StackPanel x:Name="MenuItemsPanel">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,4">
                <Image Width="20" Height="20"
                       Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
                <TextBlock Text="Disturn" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border Height="1" Margin="8,3" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Button x:Name="OpenMenuButton" Style="{StaticResource TrayMenuItemStyle}" Click="OpenMenuButton_Click"
                    AutomationProperties.Name="Open Disturn">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                    <TextBlock Text="Open Disturn" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="SettingsMenuButton" Style="{StaticResource TrayMenuItemStyle}" Click="SettingsMenuButton_Click"
                    AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="ExitMenuButton" Style="{StaticResource TrayMenuItemStyle}" Click="ExitMenuButton_Click"
                    AutomationProperties.Name="Exit Disturn">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                    <TextBlock Text="Exit" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
