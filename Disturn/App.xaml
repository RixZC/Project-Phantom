<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Disturn.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Disturn">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Windows 11 blue for light UI; dark/high contrast retain native accents. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6005FB8" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC005FB8" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#003E92" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#001A68" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#005FB8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
